    "web_search": {
      "script": "~/.pi/profiles/registry/web-search/scripts/free-search",
      "backend": "free-search",
      "brave": "auto"
    },
    "web_search_provider": {
      "script": "~/.pi/profiles/registry/web-search/scripts/web-search",
      "provider": "duckduckgo"
    },
    "reddit": {
      "cwd": "~/Documents/PersonalCodingProjects/Research/redditScrapingSearching",
      "cwd_candidates": [
        "/home/andrew/mnt/dell321/Documents/PersonalCodingProjects/Research/redditScrapingSearching"
      ],
      "cli": [".venv/bin/python", "-m", "reddit_research.cli"]
    },
    "cli_timeout_s": 60
  },
  "hops_log": {"path": "service/logs/hops.jsonl", "enabled": true},
  "http": {"host": "127.0.0.1", "port": 8090}
