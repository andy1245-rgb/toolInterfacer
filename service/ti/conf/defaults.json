{
  "decide": {
    "routing": "heuristic_micro_then_d1",
    "max_candidates": 6,
    "max_criteria_chars": 200,
    "cache": {
      "enabled": true,
      "max_entries": 256
    },
    "d1_systemone": {
      "base_url": "http://127.0.0.1:8080",
      "timeout_s": 30
    },
    "logit_read": {
      "base_url": "http://127.0.0.1:8080",
      "model": "jev-style",
      "timeout_s": 30
    },
    "classical": {
      "corpus_path": "bench/registry_382.json",
      "loss": "squared_hinge",
      "c": 1.0,
      "epochs": 100,
      "eta": 0.3,
      "ngram_max": 2,
      "min_df": 1,
      "sublinear_tf": true,
      "seed": 42,
      "abstain_label": "__none__",
      "temperature": 1.0
    },
    "fixture": {
      "fixture_path": "",
      "default_choice_conf": 0.95,
      "default_noul": 0.9
    },
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "model": "z-ai/glm-5.3-flash",
      "provider": {
        "only": [
          "Relace"
        ],
        "allow_fallbacks": true
      },
      "reasoning": {
        "effort": "minimal"
      },
      "key_env": "TI_OPENROUTER_API_KEY",
      "user": "toolinterfacer",
      "timeout_s": 30,
      "max_tokens": 64,
      "json_object": true
    },
    "backends_in_use": {
      "choice": "pair",
      "noul": "fixture",
      "extract": "rule_extract"
    },
    "pair": {
      "stage1": "d1_systemone",
      "stage2": "openrouter",
      "tau": 0.9,
      "escalate_on_error": true
    },
    "cascade": {
      "enabled": false,
      "stage1": "d1_systemone",
      "stage2": "logit_read",
      "tau_hi": 0.7,
      "tau_lo": 0.4,
      "tau2": 0.5,
      "precision_target": 0.85,
      "path_conf": {
        "stage1_confident": 0.87,
        "agreement": 0.79,
        "stage2_alone": 0.8
      }
    }
  },
  "policy": {
    "gate_route": 0.7,
    "gate_slot": 0.7,
    "gate_noul": 0.75,
    "max_asks": 2
  },
  "budget": {
    "max_hops": 24,
    "max_asks": 2,
    "max_seconds": 180
  },
  "context": {
    "digest_max_tokens": 400,
    "state_max_tokens": 2000
  },
  "research": {
    "query_count": [
      3,
      6
    ],
    "pick_top_k": 4,
    "good_pages_target": 4,
    "reddit_cross_check": "auto",
    "backends": [
      "free-search"
    ],
    "digest": {
      "claim_chars": 360
    }
  },
  "reddit": {
    "use_backend": "reddit-research",
    "thread_cap": 5
  },
  "ops": {
    "web_fetch": {
      "script": "",
      "max_chars": 20000
    },
    "web_search": {
      "script": "",
      "backend": "free-search",
      "brave": "auto"
    },
    "web_search_provider": {
      "script": "",
      "provider": "duckduckgo"
    },
    "reddit": {
      "cwd": "",
      "cwd_candidates": [],
      "cli": [
        ".venv/bin/python",
        "-m",
        "reddit_research.cli"
      ]
    },
    "cli_timeout_s": 60,
    "filesys": {
      "roots": [
        "~",
        ".",
        "/tmp"
      ],
      "deny_roots": [],
      "max_depth": 12,
      "max_files": 20000,
      "deadline_s": 5.0,
      "glob": {
        "max_hits": 2000
      },
      "grep": {
        "max_hits": 200,
        "files_per_dir": 50,
        "pattern_max_chars": 200,
        "line_max_chars": 400
      },
      "read": {
        "max_lines": 2000,
        "max_bytes": 262144
      }
    }
  },
  "hops_log": {
    "path": "service/logs/hops.jsonl",
    "enabled": true
  },
  "http": {
    "host": "127.0.0.1",
    "port": 1113,
    "token_env": "TI_HTTP_TOKEN",
    "token_file": "~/.local/state/ti/http.token",
    "max_body_bytes": 262144,
    "max_workers": 16,
    "allowed_ops": [
      "filesys_read",
      "filesys_glob",
      "filesys_grep"
    ]
  }
}
