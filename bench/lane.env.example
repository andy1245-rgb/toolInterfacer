# bench/lane.env.example — machine-specific paths for bench/lane.sh.
#
# Copy to bench/lane.env (gitignored) and edit, then:  . bench/lane.env && bash bench/lane.sh ...
# Nothing here belongs in the repo: these describe one machine (bench-host), not the code.

# Lab dir on bench-host: models/, logs/, and serve_pyhost.py live here.
DELL_LAB=C:/path/to/lab

# The python.exe whose bin dir holds the llama-server impl DLLs (serves the model).
DELL_E3_PY=C:/path/to/sibling/lab/d1bench/e3/python.exe

# bench/sv2lane.sh only: path to tibench.py on bench-host.
# DELL_TIBENCH=C:/path/to/sibling/lab/d1bench/tibench.py

# bench/pyhost_qwen35.py only: empty by default, because it must be a path the
# bench host can read through its mounted share — there is no portable default.
# DELL_QDIAG_CONFIG=/path/to/mount/bench-host/<lab>/qdiag_config.json
