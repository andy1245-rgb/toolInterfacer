# bench/lane.env.example — machine-specific paths for bench/lane.sh.
#
# Copy to bench/lane.env (gitignored) and edit, then:  . bench/lane.env && bash bench/lane.sh ...
# Nothing here belongs in the repo: these describe one machine (dell321), not the code.

# Lab dir on dell321: models/, logs/, and serve_pyhost.py live here.
DELL_LAB=C:/path/to/toolInterfacerLab

# The python.exe whose bin dir holds the llama-server impl DLLs (serves the model).
DELL_E3_PY=C:/path/to/jevResearch/lab/d1bench/e3/python.exe

# bench/sv2lane.sh only: path to tibench.py on dell321.
# DELL_TIBENCH=C:/path/to/jevResearch/lab/d1bench/tibench.py

# bench/pyhost_qwen35.py only: the local mount of the dell321 filesystem.
# DELL_MOUNT=/path/to/mount/dell321
